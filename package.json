{
	"name": "@lpm-registry/mcp-server",
	"version": "0.4.1",
	"description": "Retired: the LPM CLI serves MCP itself from 0.86.0 as `lpm mcp serve`. This last release hands off to it when installed.",
	"author": "LPM <hello@lpm.dev> (https://lpm.dev)",
	"repository": {
		"type": "git",
		"url": "https://github.com/lpm-dev/mcp-server"
	},
	"homepage": "https://lpm.dev",
	"license": "ISC",
	"keywords": [
		"lpm",
		"mcp",
		"model-context-protocol",
		"package-registry",
		"ai-tools"
	],
	"type": "module",
	"main": "lib/server.js",
	"bin": {
		"lpm-mcp-server": "./bin/mcp-server.js"
	},
	"exports": {
		".": "./lib/server.js"
	},
	"files": [
		"bin",
		"lib",
		"!lib/__tests__",
		"README.md"
	],
	"scripts": {
		"prepare": "husky",
		"start": "node bin/mcp-server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.0",
		"zod": "^3.25 || ^4.0"
	},
	"optionalDependencies": {
		"keytar": "^7.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"husky": "^9.1.7",
		"vitest": "^3.0.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
